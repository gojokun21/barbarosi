{#
	Header: stânga navigație (mega meniu), centru logo, dreapta căutare (partial/header-search.twig) / cont / coș.
	Pe prima pagină e transparent peste hero și devine alb la scroll, hover sau meniu deschis.
#}
<header
	class="site-header{{ header_transparent ? ' is-transparent' }}"
	x-data="siteHeader({ transparent: {{ header_transparent ? 'true' : 'false' }} })"
	:class="{ 'is-transparent': !solid }"
	@mouseenter="hovered = true"
	@mouseleave="hovered = false; scheduleClose()"
	@keydown.escape.window="closeAll()"
>
	<div class="site-header__bar">
		<div class="site-header__start">
			<button
				type="button"
				class="site-header__icon site-header__burger"
				@click="toggleDrawer()"
				aria-controls="mobile-drawer"
				:aria-expanded="drawerOpen.toString()"
				aria-expanded="false"
				aria-label="{{ __('Deschide meniul', 'barbarosi') }}"
			>
				{% include 'partial/icon.twig' with { name: 'menu' } only %}
			</button>

			<nav class="site-nav" aria-label="{{ __('Meniu principal', 'barbarosi') }}">
				<ul class="site-nav__list" role="list">
					{% for item in header.nav %}
						<li
							class="site-nav__item"
							{% if item.mega is defined %}
								@mouseenter="openMenu('{{ item.key }}')"
								@focusin="openMenu('{{ item.key }}')"
								@focusout="if (!$el.contains($event.relatedTarget)) scheduleClose()"
							{% else %}
								@mouseenter="scheduleClose()"
							{% endif %}
						>
							<a
								class="site-nav__link"
								href="{{ item.url|esc_url }}"
								{% if item.mega is defined %}
									:class="{ 'is-active': activeMenu === '{{ item.key }}' }"
									aria-haspopup="true"
									:aria-expanded="(activeMenu === '{{ item.key }}').toString()"
								{% endif %}
							>{{ item.title|e }}</a>

							{% if item.mega is defined %}
								{% include 'partial/mega-menu.twig' with { item: item, secondary: header.nav_secondary } only %}
							{% endif %}
						</li>
					{% endfor %}
				</ul>
			</nav>
		</div>

		{% include 'partial/site-logo.twig' %}

		<div class="site-header__end">
			{% include 'partial/header-search.twig' with { search: header.search } only %}

			<a class="site-header__icon site-header__account" href="{{ header.account_url|esc_url }}" aria-label="{{ __('Contul meu', 'barbarosi') }}">
				{% include 'partial/icon.twig' with { name: 'user' } only %}
			</a>
			<a class="site-header__icon site-header__cart" href="{{ header.cart_url|esc_url }}">
				{% include 'partial/icon.twig' with { name: 'bag' } only %}
				<span class="screen-reader-text">{{ __('Coșul de cumpărături', 'barbarosi') }}</span>
				{# Actualizat din JS când coșul se schimbă prin AJAX (assets/js/shop/cart.js) #}
				<span class="site-header__count" data-cart-badge {{ not header.cart_count ? 'hidden' }}>
					<span data-cart-badge-count>{{ header.cart_count }}</span><span class="screen-reader-text"> {{ __('produse', 'barbarosi') }}</span>
				</span>
			</a>
		</div>
	</div>

	{% include 'partial/mobile-drawer.twig' %}
</header>
