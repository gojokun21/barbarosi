{#
	Iconițe SVG inline (moștenesc culoarea prin currentColor).
	Folosire: {% include 'partial/icon.twig' with { name: 'search' } only %}
#}
{% set icon_class = 'icon icon--' ~ name ~ (class is defined ? ' ' ~ class : '') %}
{% if name == 'search' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.75"/><path d="m15.5 15.5 5.25 5.25"/></svg>
{% elseif name == 'user' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4.25"/><path d="M4 21c.6-4.2 3.9-6.75 8-6.75S19.4 16.8 20 21"/></svg>
{% elseif name == 'bag' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M4.75 7.75h14.5v13.5H4.75z"/><path d="M8.5 7.75V6.5a3.5 3.5 0 0 1 7 0v1.25"/></svg>
{% elseif name == 'menu' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M3 6.5h18M3 12h18M3 17.5h18"/></svg>
{% elseif name == 'close' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="m5 5 14 14M19 5 5 19"/></svg>
{% elseif name == 'plus' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M12 4v16M4 12h16"/></svg>
{% elseif name == 'minus' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M4 12h16"/></svg>
{% elseif name == 'lock' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><rect x="4.75" y="10.75" width="14.5" height="10.5" rx="1"/><path d="M8 10.75V7.5a4 4 0 0 1 8 0v3.25"/></svg>
{% elseif name == 'check' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="m4.5 12.5 5 5 10-11"/></svg>
{% elseif name == 'pin' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M12 21s-6.75-6.2-6.75-11.25a6.75 6.75 0 0 1 13.5 0C18.75 14.8 12 21 12 21z"/><circle cx="12" cy="9.75" r="2.25"/></svg>
{% elseif name == 'arrow-left' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="m14.5 5.5-6.5 6.5 6.5 6.5"/></svg>
{% elseif name == 'arrow-right' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="m9.5 5.5 6.5 6.5-6.5 6.5"/></svg>
{% elseif name == 'truck' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true" focusable="false"><path d="M2.75 6.25h11v10.5h-11zM13.75 9.75h4l3.5 3.5v3.5h-7.5"/><circle cx="6.75" cy="17.25" r="1.75" fill="#fff"/><circle cx="17.25" cy="17.25" r="1.75" fill="#fff"/></svg>
{% elseif name == 'box' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true" focusable="false"><path d="M3.75 7.5 12 3.75l8.25 3.75v9L12 20.25 3.75 16.5z"/><path d="M3.75 7.5 12 11.25l8.25-3.75M12 11.25v9M7.9 5.6l8.25 3.75"/></svg>
{% elseif name == 'card' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true" focusable="false"><rect x="2.75" y="5.75" width="18.5" height="12.5" rx="1"/><path d="M2.75 9.75h18.5M6 14.75h4"/></svg>
{% elseif name == 'chevron' %}
	<svg class="{{ icon_class }}" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>
{% endif %}
