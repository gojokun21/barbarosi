<footer class="site-footer" id="footer">
	<div class="site-footer__top">
		<nav class="site-footer__columns" aria-label="{{ __('Meniu footer', 'barbarosi') }}">
			{% for column in footer.columns %}
				<div class="site-footer__column">
					<p class="site-footer__title">{{ column.title|e }}</p>
					<ul class="site-footer__links" role="list">
						{% for link in column.links %}
							<li><a href="{{ link.url|esc_url }}">{{ link.title|e }}</a></li>
						{% endfor %}
					</ul>
				</div>
			{% endfor %}
		</nav>

		<div class="site-footer__aside">
			<p class="site-footer__title">Social</p>
			<ul class="site-footer__social" role="list">
				{% for link in footer.social %}
					<li><a href="{{ link.url|esc_url }}" rel="noopener">{{ link.title|e }}</a></li>
				{% endfor %}
			</ul>

			{# TODO: selector regiune / limbă #}
			<div class="site-footer__toggles">
				<span class="site-footer__toggle">
					{{ footer.region|e }}
					{% include 'partial/icon.twig' with { name: 'pin' } only %}
				</span>
				<span class="site-footer__toggle site-footer__toggle--flag">
					<span class="flag flag--ro" aria-hidden="true"></span>
					<span class="screen-reader-text">Română</span>
				</span>
			</div>
		</div>
	</div>

	<div class="site-footer__bottom">
		<ul class="payment-icons" role="list" aria-label="{{ __('Metode de plată', 'barbarosi') }}">
			{% for method in footer.payments %}
				<li class="payment-icon payment-icon--{{ method }}">
					{% include 'partial/payment-icon.twig' with { name: method } only %}
				</li>
			{% endfor %}
		</ul>

		<div class="site-footer__legal">
			{# Obligatoriu pentru magazinele online din România (Ordinul ANPC nr. 449/2022). TODO: pictograma oficială. #}
			<a class="anpc-badge" href="https://anpc.ro/ce-este-sal/" target="_blank" rel="noopener">ANPC — Soluționarea alternativă a litigiilor</a>
			<p class="site-footer__copyright">&copy; {{ 'now'|date('Y') }} {{ site.name|e }}</p>
		</div>
	</div>
</footer>
