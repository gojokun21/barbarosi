<footer class="site-footer" id="footer">
	<div class="site-footer__top">
		<nav class="site-footer__columns" aria-label="{{ __('Meniu footer', 'barbarosi') }}">
			{% for column in footer.columns %}
				<div class="site-footer__column">
					<p class="site-footer__title">{{ column.title|e }}</p>
					<ul class="site-footer__links" role="list">
						{% for link in column.links %}
							<li><a href="{{ link.url|esc_url }}">{{ link.title|e }}</a></li>
						{% endfor %}
					</ul>
				</div>
			{% endfor %}
		</nav>

		<div class="site-footer__aside">
			<p class="site-footer__title">Social</p>
			<ul class="site-footer__social" role="list">
				{% for link in footer.social %}
					<li><a href="{{ link.url|esc_url }}" rel="noopener">{{ link.title|e }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>

	<div class="site-footer__bottom">
		<img
			class="site-footer__payments"
			src="{{ site.theme.link }}/assets/images/payment-methods.png"
			alt="{{ __('Metode de plată acceptate', 'barbarosi') }}"
			width="417"
			height="73"
			loading="lazy"
			decoding="async"
		>

		<div class="site-footer__legal">
			<p class="site-footer__copyright">&copy; {{ 'now'|date('Y') }} {{ site.name|e }}</p>
		</div>
	</div>
</footer>
